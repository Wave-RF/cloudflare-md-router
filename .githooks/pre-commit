#!/usr/bin/env bash
# Runs `pnpm run verify` (biome check + tsc --noEmit + node --test + the
# release-config check) unless scripts/ci-marker.sh says it already passed for
# the current tree (cached marker). Universal — applies to humans and Claude
# Code alike. Bypass: `git commit --no-verify`.
#
# Installed by `pnpm run setup` (git config core.hooksPath .githooks).

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

if scripts/ci-marker.sh has-marker 2>/dev/null; then
  echo "✔ pre-commit: verify already passed for this tree (cached)" >&2
  exit 0
fi

# Run verify without git's hook environment. Git exports GIT_INDEX_FILE (the
# index being committed) to hooks, and the tests run `git add` in throwaway
# fixture repos: with that variable inherited, those adds wrote the fixture's
# files into THIS index (and staged deletions of src/), so the commit silently
# recorded the wrong tree. verify reads the working tree, not the index, and we
# are already at the top level.
# `pnpm run verify` writes the tree marker on success (its tail step).
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE pnpm run verify \
  || { echo "🛑 pre-commit: 'pnpm run verify' failed." >&2; exit 1; }
